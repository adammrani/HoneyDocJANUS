GROQ_API_KEY=
CANARYTOKEN_SERVER=https://canarytokens.org
CANARYTOKEN_API_PATH=/d3aece8093b71007b5ccfedad91ebb11
CANARYTOKEN_EMAIL=
CANARYTOKEN_TIMEOUT_SECONDS=10
# Laissez false tant que CALLBACK_BASE_URL pointe vers localhost.
CANARYTOKEN_WEBHOOK_ENABLED=false
CALLBACK_BASE_URL=http://localhost:8000
API_HOST=127.0.0.1
API_PORT=8000
# Générez une valeur longue (exemple PowerShell :
# [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)))
JANUS_ADMIN_API_KEY=
# Sans clé, seules les requêtes locales peuvent utiliser les routes administratives.
JANUS_ALLOW_UNAUTHENTICATED_LOCAL=true
JANUS_DEPLOY_ROOT=data/shared
ROTATION_INTERVAL_MINUTES=30
DECOY_INFRA_ENABLED=true
DECOY_BIND_HOST=127.0.0.1
DECOY_HTTP_PORT=8080
DECOY_SSH_PORT=2222

# Collecte automatique Wazuh -> JANUS (désactivée tant que le mot de passe
# local n'est pas renseigné). Gardez WAZUH_VERIFY_SSL=true en production et
# indiquez le certificat CA avec WAZUH_CA_CERT_PATH.
WAZUH_AUTO_COLLECT_ENABLED=false
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=
WAZUH_VERIFY_SSL=true
WAZUH_CA_CERT_PATH=
WAZUH_RULE_ID=100100
WAZUH_ADDITIONAL_RULE_IDS=100101,100102,100103,100104
WAZUH_INDEX_PATTERN=wazuh-alerts-4.x-*
WAZUH_POLL_INTERVAL_SECONDS=5
WAZUH_INITIAL_LOOKBACK_MINUTES=15
WAZUH_OVERLAP_SECONDS=120
WAZUH_EVENT_SETTLE_SECONDS=3
WAZUH_BATCH_SIZE=200
WAZUH_REQUEST_TIMEOUT_SECONDS=10
WAZUH_DEPLOYMENT_GRACE_SECONDS=15

# Collecte forensique étendue depuis le même Wazuh Indexer.
# FORENSIC_AGENT_IDS vide = tous les agents. En production, limitez cette liste.
FORENSIC_TELEMETRY_ENABLED=false
FORENSIC_WINDOWS_EVENT_IDS=4624,4663,4688,5145,1,3,11,22,23,26
FORENSIC_AUDIT_KEYS=audit-wazuh-c,janus-command
FORENSIC_AGENT_IDS=
FORENSIC_LOGON_TYPES=2,3,8,9,10,11,12,13
