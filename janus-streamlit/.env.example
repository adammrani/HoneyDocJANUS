# --- Application locale ---
JANUS_API_HOST=127.0.0.1
JANUS_API_PORT=8000
JANUS_STREAMLIT_HOST=127.0.0.1
JANUS_STREAMLIT_PORT=8501

# Adresse joignable inscrite dans les nouveaux DOCX.
# Pour un laboratoire à deux machines : http://192.168.1.25:8000
JANUS_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Facultatif : protège les routes administratives hors localhost.
JANUS_ADMIN_API_KEY=
CANARY_WEBHOOK_SECRET=
WAZUH_INGEST_SECRET=

# --- Contenu ---
# template = hors ligne déclaré ; api = API obligatoire ; auto = API puis repli déclaré.
AI_MODE=template
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30

# --- Canarytokens officiel (facultatif et expérimental) ---
CANARY_BASE_URL=https://canarytokens.org
CANARY_API_PATH=/d3aece8093b71007b5ccfedad91ebb11
CANARY_ALERT_EMAIL=
CANARY_WEBHOOK_URL=

# --- Collecte Wazuh Indexer (facultative) ---
WAZUH_AUTO_COLLECT=false
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEX_PATTERN=wazuh-alerts-4.x-*
WAZUH_VERIFY_SSL=true
WAZUH_POLL_SECONDS=10

